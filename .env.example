# .env olarak kopyalayın. Bu dosya .gitignore'dadır, depoya girmez.
# install.sh bu dosyayı rastgele parolalarla otomatik üretebilir.
DB_PASSWORD=degistirin
GRAFANA_PASSWORD=degistirin

# Panel girişi (kullanıcı: admin) ve parola şifreleme anahtarı.
# SECRET_KEY üretimi:  openssl rand -base64 32 | tr '+/' '-_'
PANEL_PASSWORD=degistirin
SECRET_KEY=

# Alarm kanalları (devices.yaml -> alerting bölümü)
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=

# Cihaz parolaları (devices.yaml -> password_env eşleşmeleri)
NVR_MERKEZ_01_PASSWORD=
NVR_DEPO_01_PASSWORD=
SIM_PASSWORD=sim
